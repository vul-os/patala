<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>patala-examples</AssemblyName>
    <RootNamespace>Patala.Examples</RootNamespace>
    <!--
      net8.0 built on a machine that only has the .NET 10 runtime, which is the
      case here. Without this the examples fail to start with a runtime-not-
      found error that says nothing about the SDK being newer than the target.
    -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Patala.csproj" />
  </ItemGroup>

</Project>
